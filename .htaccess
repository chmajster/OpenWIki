Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\..*|composer\.(?:json|lock)|package(?:-lock)?\.json|playwright\.config\.cjs|phpunit\.xml|AGENTS\.md|install\.sh|release\.json)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application internals when the repository root is used as
    # the web root.
    RewriteRule (^|/)\. - [R=404,END]
    RewriteRule ^(?:app|bin|bootstrap|database|docker|docs|node_modules|resources|routes|scripts|storage|tests|vendor)(?:/|$) - [R=404,END,NC]

    # Public assets keep their normal /assets/... URLs.
    RewriteRule ^assets/([A-Za-z0-9_./-]+\.(?:css|js|html|png|jpe?g|gif|webp|ico|svg|woff2?))$ public/assets/$1 [END,NC]
    RewriteRule ^(?:assets|public)(?:/|$) - [R=404,END,NC]

    # Existing files in the repository root (for example favicon/robots added
    # by an administrator) may be served directly after the protected paths
    # above have been rejected.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route every application request through the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
