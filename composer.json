{
  "name": "chmajster/openwiki",
  "description": "OpenWiki enterprise knowledge base platform",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*"
  },
  "require_dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "OpenWiki\\\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenWiki\\\\Tests\\\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php -l public/index.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {}
  }
}
